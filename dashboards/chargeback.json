{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "Per-Tenant GPU Hours",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (queue) (fairshare_queue_gpu_hours_total)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "Cost Split: Guaranteed vs Borrowed (USD)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (queue) (fairshare_queue_cost_usd_total)",
          "legendFormat": "{{queue}} total cost",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (fairshare_queue_gpus_borrowed) * 2.50",
          "legendFormat": "{{queue}} borrowed cost rate",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "title": "Cluster GPU Allocation Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(fairshare_queue_gpus_allocated) / sum(fairshare_queue_gpus_guaranteed)",
          "legendFormat": "allocated / guaranteed",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "title": "Queue Wait Time p50 / p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fairshare_scheduling_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fairshare_scheduling_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "title": "Fairness Deviation (allocated vs entitled share)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "abs(sum by (queue) (fairshare_queue_gpus_allocated) - sum by (queue) (fairshare_queue_gpus_guaranteed))",
          "legendFormat": "{{queue}} deviation (GPUs)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 6,
      "title": "Preemptions and Reclaims",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (queue, reason) (rate(fairshare_preemptions_total[5m]))",
          "legendFormat": "preempt {{queue}}/{{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (rate(fairshare_reclaims_total[5m]))",
          "legendFormat": "reclaim {{queue}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 7,
      "title": "Pending Pods per Queue",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (queue) (fairshare_queue_pending_pods)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fairshare", "finops", "gpu"],
  "time": {"from": "now-1h", "to": "now"},
